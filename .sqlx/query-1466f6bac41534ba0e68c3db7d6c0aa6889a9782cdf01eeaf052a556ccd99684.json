  "query": "\nUPDATE agent_sdk_execution_intents\nSET status          = $3,\n    error           = $4,\n    resolution      = $5,\n    captured_output = $6,\n    updated_at      = $7\nWHERE operation_id = $1\n  AND child_task_id = $2\n  AND (status IN ('pending', 'started') OR (resolution = 'abandoned' AND $5 = 'salvaged'))\nRETURNING effect_kind, tool_call_id AS \"tool_call_id!\"\n",
